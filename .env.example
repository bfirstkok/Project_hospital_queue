# Copy this file to .env and fill in your real values.

SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
PATIENT_APP_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://bfirstkok.github.io,https://hospital.bfirstkok.me
PATIENT_TOKEN_MAX_AGE=43200
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_RATE=3/15m
PIN_VERIFY_RATE_LIMIT=30
PIN_VERIFY_RATE_WINDOW=300
PIN_LOCKOUT_TIERS=60,300,1800

# SMTP settings for PIN reset OTP email.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=โรงพยาบาล <noreply@hospital.example>

# Leave DATABASE_URL empty to use local SQLite.
# Supabase format:
# postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
DB_SSLMODE=require
